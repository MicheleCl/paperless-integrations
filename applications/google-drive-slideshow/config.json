{
  "name": "Google Drive Slideshow",
  "version": "0.2.0",
  "status": "alpha",
  "description": "Shows one image at a time from a Google Drive folder (public link or private folder via your service account), advancing on a fixed time slot.",
  "renderPage": "./render.html",
  "settingsPage": "./settings.html",
  "icon": "./assets/icon.png",
  "nativeSettings": {
    "color": "light",
    "connectionMode": "public",
    "folderUrl": "",
    "folderResourceKey": "",
    "apiKey": "",
    "serviceAccountKey": "",
    "serviceAccountEmail": "",
    "folderId": "",
    "folderName": "",
    "folderResourceKeyPrivate": "",
    "order": "random",
    "fit": "cover",
    "slotMinutes": 60,
    "showFilename": false,
    "brightnessBoost": 0
  },
  "configVariants": [
    {
      "color": "light",
      "connectionMode": "public",
      "folderUrl": "",
      "folderResourceKey": "",
      "apiKey": "",
      "order": "random",
      "fit": "cover",
      "slotMinutes": 60,
      "showFilename": false,
      "brightnessBoost": 0
    },
    {
      "color": "light",
      "connectionMode": "public",
      "folderUrl": "",
      "folderResourceKey": "",
      "apiKey": "",
      "order": "modified",
      "fit": "contain",
      "slotMinutes": 60,
      "showFilename": true,
      "brightnessBoost": 0
    }
  ],
  "formSchema": {
    "type": "object",
    "properties": {
      "connectionMode": {
        "type": "string",
        "title": "Active connection",
        "enum": ["public", "serviceAccount"],
        "default": "public",
        "inStettingsPage": true
      },
      "folderUrl": {
        "type": "string",
        "title": "Public folder URL or ID",
        "default": "",
        "inStettingsPage": true
      },
      "folderResourceKey": {
        "type": "string",
        "title": "Public folder resource key",
        "default": "",
        "inStettingsPage": true
      },
      "apiKey": {
        "type": "string",
        "title": "Google API key",
        "format": "password",
        "default": "",
        "inStettingsPage": true
      },
      "serviceAccountKey": {
        "type": "string",
        "title": "Service account JSON key",
        "format": "password",
        "default": "",
        "inStettingsPage": true
      },
      "serviceAccountEmail": {
        "type": "string",
        "title": "Service account email",
        "default": "",
        "inStettingsPage": true
      },
      "folderId": {
        "type": "string",
        "title": "Private folder ID",
        "default": "",
        "inStettingsPage": true
      },
      "folderName": {
        "type": "string",
        "title": "Private folder name",
        "default": "",
        "inStettingsPage": true
      },
      "folderResourceKeyPrivate": {
        "type": "string",
        "title": "Private folder resource key",
        "default": "",
        "inStettingsPage": true
      },
      "order": {
        "type": "string",
        "title": "Photo order",
        "enum": ["name", "modified", "created", "random"],
        "default": "random",
        "inStettingsPage": true
      },
      "fit": {
        "type": "string",
        "title": "Image fit",
        "enum": ["cover", "contain"],
        "default": "cover",
        "inStettingsPage": true
      },
      "slotMinutes": {
        "type": "integer",
        "title": "Minutes per photo",
        "minimum": 1,
        "maximum": 1440,
        "default": 60,
        "inStettingsPage": true
      },
      "showFilename": {
        "type": "boolean",
        "title": "Show filename",
        "default": false,
        "inStettingsPage": true
      },
      "brightnessBoost": {
        "type": "number",
        "title": "Brightness boost",
        "minimum": 0,
        "maximum": 3,
        "default": 0,
        "inStettingsPage": true
      }
    }
  },
  "language": ["en", "de", "fr", "es", "it"]
}
